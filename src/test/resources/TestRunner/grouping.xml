<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

   <groups>
    <run>
       <include name="Sanity"/>
       <include name="Regression"/>
       <include name="Master"/> 
    </run>
    </groups>
    
    <listeners>
   <listener class-name="ExtentListeners.ExtentReportManager"></listener>   
   </listeners>
    
    
  <test thread-count="1" name="Test">
  <parameter name="os" value="Windows"></parameter>
  <parameter name="browser" value="chrome"></parameter>
    <classes>
       <class name="TestCases.TC001_doRegistration"/>
       <class name="TestCases.TC002_doLogin"></class>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
